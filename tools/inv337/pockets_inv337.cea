[DISABLE]
{$lua}
local function v(n) return readInteger(n) or 0 end
if v('pk_p2') > 0 and v('pk_force') == 0 then
  error('Extend Toolbelt v6: page 2 still holds ' .. v('pk_p2') .. ' item(s). Swap them back (pk_swap = 1) and put what does not fit in the chest, then disable. pk_force = 1 disables anyway (the game then moves page 2 into the chest, see report.md).')
end
