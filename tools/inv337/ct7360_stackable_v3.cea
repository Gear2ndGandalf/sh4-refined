registersymbol(st_brkp)
registersymbol(st_usep)
registersymbol(st_thiefp)
registersymbol(st_barp)
registersymbol(st_drawp)
registersymbol(st_pickp)
registersymbol(st_cmrgp)
registersymbol(st_putp)

